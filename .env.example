# ---- Mesh API (MANDATORY: every LLM/embedding call routes through here) ----
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=tencent/hy3
MESH_FAST_MODEL=minimax/m2-her
MESH_EMBED_MODEL=openai/text-embedding-3-small

# ---- App ----
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./smartreco.db
CHROMA_DIR=./chroma_store

# ---- Recommendation triggering ----
REC_COOLDOWN_SECONDS=45
REC_CATEGORY_VIEW_THRESHOLD=2
REC_TOTAL_ENGAGEMENT_THRESHOLD=4

# ---- Scheduling (bonus) ----
ENABLE_SCHEDULER=true
DIGEST_HOUR=15                    # 24h UTC hour for daily digest (cron mode)
DIGEST_MINUTE=0
DIGEST_INTERVAL_MINUTES=0         # >0 = repeat every N min (demo mode)
DELIVERY_CHANNELS=mailbox         # comma-separated: mailbox,telegram

# ---- Telegram Bot (bonus — free via @BotFather) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Observability (bonus — LangSmith tracing) ----
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco

# ---- Bootstrap admin ----
ADMIN_EMAIL=admin@smartreco.dev
ADMIN_PASSWORD=admin1234
DIGEST_INTERVAL_MINUTES=0         # >0 = repeat every N min (overrides cron)
DELIVERY_CHANNELS=mailbox         # comma-separated: mailbox,telegram

# ---- Telegram delivery (free) ----
# 1. Message @BotFather on Telegram → /newbot → copy the bot token
# 2. Message @userinfobot → copy your chat ID
# 3. Start a chat with your new bot (send /start)
TELEGRAM_BOT_TOKEN=              # e.g. 123456:ABC-DEF1234ghIkl-zyx57W2v
TELEGRAM_CHAT_ID=                  # e.g. 987654321

# ---- Observability (bonus, optional) ----
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco

# ---- Bootstrap admin (created on first run) ----
ADMIN_EMAIL=admin@smartreco.dev
ADMIN_PASSWORD=admin1234
